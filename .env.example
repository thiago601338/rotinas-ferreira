# Copie este arquivo para .env (o instalar.bat faz isso) e preencha os valores.
# O .env fica só no PC. Nunca enviar para o repositório nem colar no chat.

# Supabase do sistema da loja (projeto nailfzcujyxydqldktgg). As tabelas do estoque só abrem para usuário
# logado (RLS "authenticated"), então o script entra com um usuário próprio das rotinas e só lê.
SUPABASE_URL=https://nailfzcujyxydqldktgg.supabase.co
# Chave pública do projeto: Project Settings > API Keys > "Publishable key" (sb_publishable_...) ou a legada "anon".
SUPABASE_KEY=
# Usuário das rotinas criado em Authentication > Users (e-mail e senha).
SUPABASE_EMAIL=
SUPABASE_SENHA=

# OpenAI (ChatGPT) — só para recriar foto de várias cores sem a cor que está sem estoque (regra de 26/09/2026).
# Chave em platform.openai.com > API keys. Cada imagem recriada tem um custo pequeno na conta da OpenAI.
OPENAI_API_KEY=
